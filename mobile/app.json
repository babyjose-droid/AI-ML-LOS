{
  "expo": {
    "name": "Rhythm LOS",
    "slug": "rhythm-los",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.rhythm.los",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSMicrophoneUsageDescription": "Rhythm uses the microphone for video KYC calls with customers.",
        "NSCameraUsageDescription": "Rhythm uses the camera to photograph KYC documents, sites and collateral, and for video KYC calls."
      }
    },
    "android": {
      "package": "in.rhythm.los",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Rhythm LOS (mobile)"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Rhythm uses the camera to photograph KYC documents, sites and collateral for loan applications."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Rhythm records where field visits and site photos are taken, so they can be verified."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0d6e6e"
        }
      ]
    ]
  }
}
